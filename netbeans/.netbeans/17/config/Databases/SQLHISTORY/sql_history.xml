<sql date="1779106895336" url="jdbc:mysql://localhost:3306/db_default">SELECT 
    COUNT(*) as total_students,
    COUNT(attendance_code) as students_with_code,
    MAX(attendance_code) as max_code
FROM student s
INNER JOIN users u ON u.id = s.user_id
INNER JOIN program_semester ps ON ps.id = s.program_semester
INNER JOIN academic_year_offered_program ayop ON ayop.id = ps.academic_year_offered_program
INNER JOIN program p ON p.id = ayop.program
WHERE p.branch_id = [YOUR_BRANCH_ID]
AND u.status NOT IN ()</sql>
