package com.akshamalainfotech.erp.admin.account.voucher;

import com.akshamalainfotech.erp.admin.ejb.service.JournalVoucherMasterLedgerSubLedgerMasterMapService;
import com.akshamalainfotech.erp.admin.jsf.AdminAuthenticationBean;
import com.akshamalainfotech.erp.admin.pagination.PaginationJSFBean;
import com.akshamalainfotech.erp.admin.utils.Utility;
import com.akshamalainfotech.erp.ejb.common.beans.SearchJournalVoucherBean;
import com.akshamalainfotech.erp.ejb.common.constant.ReportGroupAccountConstant;
import com.akshamalainfotech.erp.ejb.common.dao.AdminRoleBeanRemote;
import com.akshamalainfotech.erp.ejb.common.helperAbstract.AbstractExcelDownloadHelper;
import com.akshamalainfotech.erp.ejb.common.service.JournalVoucherService;
import com.akshamalainfotech.erp.ejb.common.service.MetaTableService;
import com.akshamalainfotech.erp.ejb.common.service.ReportFormatAccountBranchMapService;
import com.akshamalainfotech.erp.ejb.dto.collegeAdmin.FiscalYearDto;
import com.akshamalainfotech.erp.ejb.dto.common.AdminDto;
import com.akshamalainfotech.erp.ejb.dto.common.BranchDto;
import com.akshamalainfotech.erp.ejb.dto.common.CollegeDto;
import com.akshamalainfotech.erp.ejb.dto.common.JournalVoucherDto;
import com.akshamalainfotech.erp.ejb.dto.common.JournalVoucherMasterLedgerSubLedgerMasterMapDto;
import com.akshamalainfotech.erp.ejb.dto.common.ReportFormatAccountDto;
import com.akshamalainfotech.erp.ejb.mapper.JournalVoucherMasterLedgerSubLedgerMasterMapMapper;
import com.akshamalainfotech.erp.ejb.service.collegeAdmin.FiscalYearService;
import com.akshamalainfotech.erp.ejb.utility.ConvertNumberToWord;
import com.akshamalainfotech.erp.ejb.utility.DateUtility;
import java.util.ArrayList;
import java.util.Collections;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import javax.annotation.PostConstruct;
