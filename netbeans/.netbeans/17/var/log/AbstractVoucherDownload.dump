import javax.faces.bean.ViewScoped;
import javax.inject.Inject;
import javax.servlet.ServletContext;
import lombok.Getter;
import lombok.Setter;
import net.sf.jasperreports.engine.JRDataSource;
import net.sf.jasperreports.engine.JRException;
import net.sf.jasperreports.engine.JasperReport;
import net.sf.jasperreports.engine.data.JRBeanCollectionDataSource;

/**
 *
 * @author paawan
 */
@Getter
@Setter
@ViewScoped
public abstract class AbstractVoucherDownload extends AbstractExcelDownloadHelper {

    @Inject
    protected JournalVoucherMasterLedgerSubLedgerMasterMapService journalVoucherMasterLedgerSubLedgerMasterMapService;

    @Inject
    protected ReportFormatAccountBranchMapService reportFormatAccountBranchMapService;

    @Inject
    protected JournalVoucherService journalVoucherService;

    @ManagedProperty(value = "#{adminAuthenticationBean}")
    protected AdminAuthenticationBean adminAuthenticationBean;

    @Inject
    protected Utility utility;

    @Inject
    protected AdminRoleBeanRemote adminRoleBeanRemote;

    @ManagedProperty(value = "#{paginationJSFBean}")
    protected PaginationJSFBean paginationJSFBean;

    protected List<JournalVoucherMasterLedgerSubLedgerMasterMapDto> journalVoucherMasterLedgerSubLedgerMasterMapDtos;

    protected JournalVoucherDto journalVoucherDto;

    protected List<FiscalYearDto> fiscalYearDtos;

    protected boolean editRole;

    protected boolean deleteRole;

    protected boolean createRole;

    protected boolean postRole;

    protected SearchJournalVoucherBean searchJournalVoucherBean;

    protected boolean selectAll;

    @Inject
    protected FiscalYearService fiscalYearService;

    protected BranchDto branchDto;

    protected AdminDto adminDto;

    protected CollegeDto collegeDto;

    @Inject
    protected MetaTableService metaTableService;

    protected JournalVoucherMasterLedgerSubLedgerMasterMapDto journalVoucherMasterLedgerSubLedgerMasterMapDto;
    
    private double totalDebitAmount;
    
    private double totalCreditAmount;

    @PostConstruct
    public void init() {
        adminDto = adminAuthenticationBean.getAdminDto();
        collegeDto = adminAuthenticationBean.getCollegeDto();
        branchDto = adminAuthenticationBean.getBranchDto();
        journalVoucherMasterLedgerSubLedgerMasterMapDto = new JournalVoucherMasterLedgerSubLedgerMasterMapDto();
        navigateToPage();
    }

    public String navigateToPage() {
        if (hasValidAdminRole()) {
            return "output.xhtml?faces-redirect=true";
        }
        checkRoles();
        journalVoucherDto = new JournalVoucherDto();
        searchJournalVoucherBean = new SearchJournalVoucherBean();
        searchJournalVoucherBean.setNotPostedOnly(Boolean.FALSE);
        fiscalYearDtos = fiscalYearService.getAllByCollegeIdForDropDown(collegeDto);
        search();
        return "";
    }

    protected abstract boolean hasValidAdminRole();

    protected abstract void checkRoles();

    public void search() {
        Utility.removeSessionBeanJSFDataModelObject("paginationJSFBean");
        paginationJSFBean = (PaginationJSFBean) Utility.getSessionObject("paginationJSFBean");
        journalVoucherMasterLedgerSubLedgerMasterMapDtos = new ArrayList();
        searchJournalVoucherBean.setBranchDto(adminAuthenticationBean.getBranchDto());
        setTransactionTypeNotInStatus();
        searchJournalVoucherBean.setShowRunningFiscalYearOnly(Boolean.TRUE);
        totalDebitAmount=0.0;
        totalCreditAmount=0.0;
        paginationJSFBean.setFirstRow(0);
        paginationJSFBean.setTotalRows(journalVoucherMasterLedgerSubLedgerMasterMapService.searchCount(searchJournalVoucherBean, collegeDto).intValue());
        if (paginationJSFBean.getTotalRows() > 0) {
            loadPaginatedData();
        } else {
            Utility.showFailureMessage("No Record(s) Found");
        }
    }

    protected abstract void setTransactionTypeNotInStatus();

    public void loadPaginatedData() {
        totalDebitAmount=0.0;
        totalCreditAmount=0.0;
        journalVoucherMasterLedgerSubLedgerMasterMapDtos = journalVoucherMasterLedgerSubLedgerMasterMapService.search(searchJournalVoucherBean, paginationJSFBean.getFirstRow(), paginationJSFBean.getRowsPerPage(), collegeDto);
        if(!journalVoucherMasterLedgerSubLedgerMasterMapDtos.isEmpty()){
            for(JournalVoucherMasterLedgerSubLedgerMasterMapDto journalVoucherMasterLedgerSubLedgerMasterMapDto:journalVoucherMasterLedgerSubLedgerMasterMapDtos){
                totalDebitAmount+=journalVoucherMasterLedgerSubLedgerMasterMapDto.getDebitAmount();
                totalCreditAmount+=journalVoucherMasterLedgerSubLedgerMasterMapDto.getDebitAmount();
            }
        }
        paginationJSFBean.paginationSetting();
    }

    public void delete() {
        if (checkIfPosted()) {
            return;
        } else {
            List<JournalVoucherDto> journalVoucherDtos = new ArrayList();
            journalVoucherDtos.add(journalVoucherDto);
            deleteJournals(journalVoucherDtos);
        }
    }

    private void deleteJournals(List<JournalVoucherDto> journalVoucherDtos) {
        if (journalVoucherService.delete(journalVoucherDtos, adminDto)) {
            Utility.showSuccessMessage("Successfully Deleted");
            search();
        }
    }

    private boolean checkIfPosted() {
        if (journalVoucherDto.isPosted() && !adminDto.isSuperAdmin() && !adminDto.isCentralAdmin() && !adminDto.getCollegeSuperAdmin()) {
            Utility.showFailureMessage("Posted Journals Are Not Allowed To Edit And Delete");
            return true;
        }
        return false;
    }

    public void postJournal() {
        List<JournalVoucherDto> journalVoucherDtos = new ArrayList();
        journalVoucherDtos.add(journalVoucherDto);
        postJournals(journalVoucherDtos);
    }

    private void postJournals(List<JournalVoucherDto> journalVoucherDtos) {
        if (journalVoucherService.postJournal(journalVoucherDtos, adminDto, adminAuthenticationBean.getBranchDto(), adminAuthenticationBean.getCollegeDto())) {
            Utility.showSuccessMessage("Successfully Posted");
            search();
        }
    }

    public void postJournalBulk() {
        Map<Long, JournalVoucherDto> journalVoucherDtoIdMap = new HashMap();
        for (JournalVoucherMasterLedgerSubLedgerMasterMapDto journalVoucherMasterLedgerSubLedgerMasterMapDto : journalVoucherMasterLedgerSubLedgerMasterMapDtos) {
            if (journalVoucherMasterLedgerSubLedgerMasterMapDto.isTransientSelected() && !journalVoucherDtoIdMap.containsKey(journalVoucherMasterLedgerSubLedgerMasterMapDto.getJournalVoucherDto().getId())) {
                journalVoucherDtoIdMap.put(journalVoucherMasterLedgerSubLedgerMasterMapDto.getJournalVoucherDto().getId(), journalVoucherMasterLedgerSubLedgerMasterMapDto.getJournalVoucherDto());
            }
        }
        if (journalVoucherDtoIdMap.isEmpty()) {
            Utility.showFailureMessage("Select At Least One");
            return;
        }
        postJournals(new ArrayList(journalVoucherDtoIdMap.values()));
    }

    public void onChangeSelectAll() {
        for (JournalVoucherMasterLedgerSubLedgerMasterMapDto journalVoucherMasterLedgerSubLedgerMasterMapDto : journalVoucherMasterLedgerSubLedgerMasterMapDtos) {
            if (selectAll) {
                journalVoucherMasterLedgerSubLedgerMasterMapDto.setTransientSelected(true);
            } else {
                journalVoucherMasterLedgerSubLedgerMasterMapDto.setTransientSelected(false);
            }
        }

    }

    public void deleteBulk() {
        Map<Long, JournalVoucherDto> journalVoucherDtoIdMap = new HashMap();
        for (JournalVoucherMasterLedgerSubLedgerMasterMapDto journalVoucherMasterLedgerSubLedgerMasterMapDto : journalVoucherMasterLedgerSubLedgerMasterMapDtos) {
            if (journalVoucherMasterLedgerSubLedgerMasterMapDto.isTransientSelected() && !journalVoucherDtoIdMap.containsKey(journalVoucherMasterLedgerSubLedgerMasterMapDto.getJournalVoucherDto().getId())) {
                if (!journalVoucherMasterLedgerSubLedgerMasterMapDto.getJournalVoucherDto().isPosted() || adminDto.isSuperAdmin()) {
                    journalVoucherDtoIdMap.put(journalVoucherMasterLedgerSubLedgerMasterMapDto.getJournalVoucherDto().getId(), journalVoucherMasterLedgerSubLedgerMasterMapDto.getJournalVoucherDto());
                } else if (adminDto.isSuperAdmin() || adminDto.isCentralAdmin()) {
                    journalVoucherDtoIdMap.put(journalVoucherMasterLedgerSubLedgerMasterMapDto.getJournalVoucherDto().getId(), journalVoucherMasterLedgerSubLedgerMasterMapDto.getJournalVoucherDto());
                } else {
                    Utility.showFailureMessage("Posted Journal Vouchers Can't Be Deleted");
                    return;
                }
            }
        }
        if (journalVoucherDtoIdMap.isEmpty()) {
            Utility.showFailureMessage("Select At Least One");
            return;
        }
        deleteJournals(new ArrayList(journalVoucherDtoIdMap.values()));
    }

    @Override
    protected String setJrxmlFile(ServletContext context) {
        ReportFormatAccountDto reportFormatAccountDto = reportFormatAccountBranchMapService.getActiveOnlyByBranchIdAndReportGroup(adminAuthenticationBean.getBranchDto(), ReportGroupAccountConstant.VOUCHER.getName(), collegeDto);
        return setJrxmlFile(context, reportFormatAccountDto.getReportFormatPath());
    }

    @Override
    protected Map setParametersToDownload(ServletContext context, JasperReport jr, JRDataSource dataSource) throws JRException {
        Map paramertersMap = new HashMap();

        paramertersMap.put("journalVoucherNumber", journalVoucherDto.getJournalVoucherNumber());
        paramertersMap.put("transactionDate", DateUtility.convertToAd(journalVoucherDto.getTransactionDateBs()));
        paramertersMap.put("transientTransactionDateBs", journalVoucherDto.getTransactionDateBs());
        paramertersMap.put("preparedDesignation", journalVoucherDto.getPreparedDesignation());
        paramertersMap.put("preparedBy", journalVoucherDto.getPreparedBy());
        paramertersMap.put("preparedDate", journalVoucherDto.getPreparedDate());
        paramertersMap.put("forwardedBy", journalVoucherDto.getForwardedBy());
        paramertersMap.put("forwardedDesignation", journalVoucherDto.getForwardedDesignation());
        paramertersMap.put("forwardedDate", journalVoucherDto.getForwardedDate());
        paramertersMap.put("approvedBy", journalVoucherDto.getApprovedBy());
        paramertersMap.put("approvedDesignation", journalVoucherDto.getApprovedDesignation());
        paramertersMap.put("approvedDate", journalVoucherDto.getApprovedDate());
        paramertersMap.put("collegeName", branchDto.getName());
        paramertersMap.put("collegeAddress", branchDto.getAddress());
        paramertersMap.put("boardImageLogo", branchDto.getCollegeLogoPath());
        paramertersMap.put("voucherType", journalVoucherDto.getVoucherTransactionType());
        paramertersMap.put("inWords", ConvertNumberToWord.convertNumber((long) journalVoucherDto.getTotalDebitAmount()));
        paramertersMap.put("collegeContact", branchDto.getContact());
        paramertersMap.put("panNumber", branchDto.getPanNumber());
        return paramertersMap;
    }

    @Override
    protected JRBeanCollectionDataSource setListToCollectionDataSource() {
        List<JournalVoucherMasterLedgerSubLedgerMasterMapDto> journalVoucherMasterLedgerSubLedgerMasterMapDtos = journalVoucherMasterLedgerSubLedgerMasterMapService.getActiveOnlyByJournalVoucherId(journalVoucherDto, collegeDto);
        for (JournalVoucherMasterLedgerSubLedgerMasterMapDto journalVoucherMasterLedgerSubLedgerMasterMapDto : journalVoucherMasterLedgerSubLedgerMasterMapDtos) {
            if (journalVoucherMasterLedgerSubLedgerMasterMapDto.getSubLedgerMasterDto().getId() == null) {
                journalVoucherMasterLedgerSubLedgerMasterMapDto.getSubLedgerMasterDto().setName("");
                journalVoucherMasterLedgerSubLedgerMasterMapDto.setTransientParticulars(journalVoucherMasterLedgerSubLedgerMasterMapDto.getLedgerMasterBranchMapDto().getLedgerMasterDto().getName());
            } else {
                journalVoucherMasterLedgerSubLedgerMasterMapDto.setTransientParticulars(journalVoucherMasterLedgerSubLedgerMasterMapDto.getLedgerMasterBranchMapDto().getLedgerMasterDto().getName() + " " + journalVoucherMasterLedgerSubLedgerMasterMapDto.getSubLedgerMasterDto().getName());
            }

        }
        Collections.sort(journalVoucherMasterLedgerSubLedgerMasterMapDtos, JournalVoucherMasterLedgerSubLedgerMasterMapMapper.orderComparator);

        return new JRBeanCollectionDataSource(journalVoucherMasterLedgerSubLedgerMasterMapDtos, false);
    }

    public void downloadVoucherDetail() {
        try {
            ReportFormatAccountDto reportFormatAccountDto = reportFormatAccountBranchMapService.getActiveOnlyByBranchIdAndReportGroup(adminAuthenticationBean.getBranchDto(), ReportGroupAccountConstant.VOUCHER.getName(), collegeDto);
            if (reportFormatAccountDto.getId() == null) {
                Utility.showFailureMessage("Account Report Format Not Found for Current Branch");
                return;
            }
            downloadPdf();
        } catch (Exception e) {
            e.getMessage();
        }
    }

    public String initEdit() {
        if (checkIfPosted()) {
            return null;
        }
        return returnToEditPage();
    }

    protected abstract String returnToEditPage();

}

