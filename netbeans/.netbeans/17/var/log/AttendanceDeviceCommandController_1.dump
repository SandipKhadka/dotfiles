package com.akshamalainfotech.erp.admin.attendanceDevice.command;

import com.akshamalainfotech.erp.admin.jsf.AdminAuthenticationBean;
import com.akshamalainfotech.erp.admin.pagination.PaginationJSFBean;
import com.akshamalainfotech.erp.admin.utils.Utility;
import com.akshamalainfotech.erp.ejb.dto.collegeAdmin.AttendanceDeviceCommandDto;
import com.akshamalainfotech.erp.ejb.dto.collegeAdmin.AttendanceDeviceDto;
import com.akshamalainfotech.erp.ejb.dto.common.AdminDto;
import com.akshamalainfotech.erp.ejb.dto.common.CollegeDto;
import com.akshamalainfotech.erp.ejb.service.collegeAdmin.AttendanceDeviceService;
import com.akshamalainfotech.erp.ejb.service.collegeAdmin.attendance.command.AttendanceDeviceCommandService;
import lombok.Getter;
import lombok.Setter;

import javax.annotation.PostConstruct;
import javax.faces.bean.ManagedBean;
import javax.faces.bean.ManagedProperty;
import javax.faces.bean.ViewScoped;
import javax.inject.Inject;
import java.io.Serializable;
import java.util.ArrayList;
import java.util.List;

@Getter
@Setter
@ViewScoped
@ManagedBean
public class AttendanceDeviceCommandController implements Serializable {

    @ManagedProperty(value = "#{adminAuthenticationBean}")
    private AdminAuthenticationBean adminAuthenticationBean;
    
    private CollegeDto collegeDto;
    private BranchDto branchDto

    @Inject
    private AttendanceDeviceCommandService attendanceDeviceCommandService;
    @Inject
    private AttendanceDeviceService attendanceDeviceService;

    private AdminDto adminDto;
    private AttendanceDeviceDto attendanceDeviceDto;
    private List<AttendanceDeviceCommandDto> attendanceDeviceCommandDtos;
    private List<AttendanceDeviceDto> attendanceDeviceDtos;
    @ManagedProperty(value = "#{paginationJSFBean}")
    private PaginationJSFBean paginationJSFBean;

    @PostConstruct
    public void init() {
        initUserContext();
        initializePagination();
        attendanceDeviceCommandDtos = new ArrayList<>();
        attendanceDeviceDto = new AttendanceDeviceDto();
        attendanceDeviceCommandDtos = attendanceDeviceService.getAllBYBranch(branchDto);
    }

    private void initUserContext() {
        adminDto = adminAuthenticationBean.getAdminDto();
    }

    private void initializePagination() {
        paginationJSFBean = new PaginationJSFBean();
    }

    public void loadCommandHistory() {
        if (attendanceDeviceDto == null || attendanceDeviceDto.getId() == null) {
            clearCommandHistory();
            return;
        }


        try {
            paginationJSFBean.setTotalRows(attendanceDeviceCommandService.count(attendanceDeviceDto).intValue());
            paginationJSFBean.paginationSetting();

            attendanceDeviceCommandDtos = attendanceDeviceCommandService.getByDevice(
                    attendanceDeviceDto,
                    paginationJSFBean.getFirstRow(),
                    paginationJSFBean.getRowsPerPage()
            );
        } catch (Exception e) {
            Utility.showFailureMessage("Failed to load command history");
            clearCommandHistory();
        }
    }

    public void searchCommandHistory() {
        resetCommandPagination();
        loadCommandHistory();
    }

    public void refreshCommands() {
        if (attendanceDeviceDto != null && attendanceDeviceDto.getId() != null) {
            loadCommandHistory();
            Utility.showInfoMessage("Command history refreshed");
        } else {
            Utility.showWarningMessage("No device selected");
        }
    }

    public void clearCommandHistory() {
        attendanceDeviceCommandDtos = new ArrayList<>();
        paginationJSFBean.setTotalRows(0);
    }

    private void resetCommandPagination() {
        paginationJSFBean.setFirstRow(0);
        paginationJSFBean.paginationSetting();
    }


}
