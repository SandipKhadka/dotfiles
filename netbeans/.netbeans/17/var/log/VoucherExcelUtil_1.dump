package com.akshamalainfotech.erp.admin.assignedFee.create;

import com.akshamalainfotech.erp.ejb.dto.common.LedgerMasterBranchMapDto;
import com.akshamalainfotech.erp.ejb.dto.common.SubLedgerMasterDto;
import com.akshamalainfotech.erp.ejb.dto.common.SubLedgerMasterLedgerMasterBranchMapMapDto;
import org.apache.poi.hssf.usermodel.*;
import org.apache.poi.ss.usermodel.*;

import javax.faces.context.FacesContext;
import javax.servlet.http.HttpServletResponse;
import java.io.*;
import java.util.*;

public class VoucherExcelUtil extends ExcelUtils {

    public static void downloadVoucherTemplate(String fileName,
            List<LedgerMasterBranchMapDto> ledgers,
            List<SubLedgerMasterDto> subLedgers) throws IOException {

        if (ledgers == null || ledgers.isEmpty()) {
            throw new IllegalArgumentException("No ledgers available for template");
        }

        HSSFWorkbook workbook = new HSSFWorkbook();

        // Create all three sheets
        HSSFSheet voucherSheet = workbook.createSheet("Voucher Entry");
        HSSFSheet ledgersSheet = workbook.createSheet("Ledgers");
        HSSFSheet subLedgersSheet = workbook.createSheet("SubLedgers");

        // Populate sheets
        populateLedgerSheet(ledgersSheet, ledgers, workbook);
        populateSubLedgerSheet(subLedgersSheet, subLedgers, workbook);
        createVoucherEntrySheet(voucherSheet, ledgers, subLedgers, workbook);

        // Make voucher sheet active
        workbook.setActiveSheet(0);

        // Download
        downloadWorkbook(workbook, fileName);
    }

    private static void createVoucherEntrySheet(HSSFSheet sheet,
            List<LedgerMasterBranchMapDto> ledgers,
            List<SubLedgerMasterDto> subLedgers,
            HSSFWorkbook workbook) {

        // Create styles
        HSSFCellStyle headerStyle = createHeaderStyle(workbook);
        HSSFCellStyle footerStyle = createFooterStyle(workbook);
        HSSFCellStyle numberStyle = createNumberStyle(workbook);
        HSSFCellStyle formulaStyle = createFormulaStyle(workbook);
        HSSFCellStyle instructionStyle = createInstructionStyle(workbook);

        int currentRow = 0;

        // Add instructions at the top
        Row instructionRow1 = sheet.createRow(currentRow++);
        Cell instr1 = instructionRow1.createCell(0);
        instr1.setCellValue("INSTRUCTIONS: Enter Ledger Name in column B, SubLedger Name in column D. IDs will auto-populate from lookup tables.");
        instr1.setCellStyle(instructionStyle);
        sheet.addMergedRegion(new org.apache.poi.ss.util.CellRangeAddress(0, 0, 0, 6));

        Row instructionRow2 = sheet.createRow(currentRow++);
        Cell instr2 = instructionRow2.createCell(0);
        instr2.setCellValue("See 'Ledgers' and 'SubLedgers' sheets for available values. Copy names exactly as shown in Display Name column.");
        instr2.setCellStyle(instructionStyle);
        sheet.addMergedRegion(new org.apache.poi.ss.util.CellRangeAddress(1, 1, 0, 6));

        // Blank row
        currentRow++;

        // Create header row
        Row headerRow = sheet.createRow(currentRow++);
        String[] headers = {"Ledger ID", "Ledger Name", "SubLedger ID", "SubLedger Name",
            "Debit Amount", "Credit Amount", "Description"};

        for (int i = 0; i < headers.length; i++) {
            Cell cell = headerRow.createCell(i);
            cell.setCellValue(headers[i]);
            cell.setCellStyle(headerStyle);
        }

        // Create one blank row for data entry
        int dataStartRow = currentRow;
        Row dataRow = sheet.createRow(currentRow++);

        // Column A: Ledger ID - VLOOKUP formula to get ID from Ledgers sheet
        // The VLOOKUP range Ledgers!$C$2:$A$... includes columns C, B, A
        // Column C = Display Name (lookup value), Column A = Ledger ID (return value)
        // So we need column index 3 (C=1, B=2, A=3)
        Cell ledgerIdCell = dataRow.createCell(0);
        ledgerIdCell.setCellFormula(String.format(
                "IF(B%d=\"\",\"\",IF(ISNA(VLOOKUP(B%d,Ledgers!$C$2:$A$%d,3,FALSE)),\"\",VLOOKUP(B%d,Ledgers!$C$2:$A$%d,3,FALSE)))",
                dataStartRow + 1, dataStartRow + 1, ledgers.size() + 2,
                dataStartRow + 1, dataStartRow + 1, ledgers.size() + 2
        ));
        ledgerIdCell.setCellStyle(formulaStyle);

        // Column B: Ledger Name - user input
        dataRow.createCell(1);

        // Column C: SubLedger ID - VLOOKUP formula
        // The VLOOKUP range SubLedgers!$E$2:$A$... includes columns E, D, C, B, A
        // Column E = Display Name (lookup value), Column A = SubLedger ID (return value)
        // So we need column index 5 (E=1, D=2, C=3, B=4, A=5)
        Cell subLedgerIdCell = dataRow.createCell(2);
        subLedgerIdCell.setCellFormula(String.format(
                "IF(D%d=\"\",\"\",IF(ISNA(VLOOKUP(D%d,SubLedgers!$E$2:$A$%d,5,FALSE)),\"\",VLOOKUP(D%d,SubLedgers!$E$2:$A$%d,5,FALSE)))",
                dataStartRow + 1, dataStartRow + 1, subLedgers.size() + 100,
                dataStartRow + 1, dataStartRow + 1, subLedgers.size() + 100
        ));
        subLedgerIdCell.setCellStyle(formulaStyle);

        // Column D: SubLedger Name - user input
        dataRow.createCell(3);

        // Columns E & F: Debit/Credit amounts
        dataRow.createCell(4).setCellStyle(numberStyle);
        dataRow.createCell(5).setCellStyle(numberStyle);

        // Column G: Description
        dataRow.createCell(6);

        // Create footer row
        int footerRow = currentRow++;
        Row totalRow = sheet.createRow(footerRow);

        // Empty cells before totals
        for (int i = 0; i < 4; i++) {
            totalRow.createCell(i);
        }

        // Total Debit
        Cell totalDebit = totalRow.createCell(4);
        totalDebit.setCellFormula(String.format("SUM(E%d:E1000)", dataStartRow + 1));
        totalDebit.setCellStyle(footerStyle);

        // Total Credit
        Cell totalCredit = totalRow.createCell(5);
        totalCredit.setCellFormula(String.format("SUM(F%d:F1000)", dataStartRow + 1));
        totalCredit.setCellStyle(footerStyle);

        // "Total" label
        Cell totalLabel = totalRow.createCell(6);
        totalLabel.setCellValue("Total");
        totalLabel.setCellStyle(footerStyle);

        // Set column widths
        sheet.setColumnWidth(0, 3000);  // Ledger ID
        sheet.setColumnWidth(1, 8000);  // Ledger Name
        sheet.setColumnWidth(2, 3000);  // SubLedger ID
        sheet.setColumnWidth(3, 8000);  // SubLedger Name
        sheet.setColumnWidth(4, 4000);  // Debit Amount
        sheet.setColumnWidth(5, 4000);  // Credit Amount
        sheet.setColumnWidth(6, 10000); // Description

        // Freeze panes at header row
        sheet.createFreezePane(0, 4);
    }

    private static void populateLedgerSheet(HSSFSheet sheet,
            List<LedgerMasterBranchMapDto> ledgers,
            HSSFWorkbook workbook) {

        // Create header
        HSSFCellStyle headerStyle = createHeaderStyle(workbook);
        HSSFCellStyle instructionStyle = createInstructionStyle(workbook);

        // Instruction row
        Row instrRow = sheet.createRow(0);
        Cell instr = instrRow.createCell(0);
        instr.setCellValue("Reference: Copy values from 'Display Name' column when filling Voucher Entry");
        instr.setCellStyle(instructionStyle);
        sheet.addMergedRegion(new org.apache.poi.ss.util.CellRangeAddress(0, 0, 0, 2));

        Row headerRow = sheet.createRow(1);
        String[] headers = {"Ledger ID", "Ledger Name", "Display Name"};
        for (int i = 0; i < headers.length; i++) {
            Cell cell = headerRow.createCell(i);
            cell.setCellValue(headers[i]);
            cell.setCellStyle(headerStyle);
        }

        // Check for duplicates
        Map<String, Integer> nameCount = new HashMap<String, Integer>();
        for (LedgerMasterBranchMapDto ledger : ledgers) {
            String name = ledger.getLedgerMasterDto().getName();
            nameCount.put(name, nameCount.getOrDefault(name, 0) + 1);
        }

        // Populate data
        for (int i = 0; i < ledgers.size(); i++) {
            LedgerMasterBranchMapDto ledger = ledgers.get(i);
            Row row = sheet.createRow(i + 2);

            Long id = ledger.getLedgerMasterDto().getId();
            String name = ledger.getLedgerMasterDto().getName();

            // Column A: Ledger ID
            row.createCell(0).setCellValue(id);

            // Column B: Ledger Name
            row.createCell(1).setCellValue(name);

            // Column C: Display Name (with ID if duplicate)
            Cell displayCell = row.createCell(2);
            if (nameCount.get(name) > 1) {
                displayCell.setCellValue(name + " [" + id + "]");
            } else {
                displayCell.setCellValue(name);
            }
        }

        // Set column widths
        sheet.setColumnWidth(0, 3000);
        sheet.setColumnWidth(1, 8000);
        sheet.setColumnWidth(2, 8000);
    }

    private static void populateSubLedgerSheet(HSSFSheet sheet,
            List<SubLedgerMasterDto> subLedgers,
            HSSFWorkbook workbook) {

        // Create header
        HSSFCellStyle headerStyle = createHeaderStyle(workbook);
        HSSFCellStyle instructionStyle = createInstructionStyle(workbook);

        // Instruction row
        Row instrRow = sheet.createRow(0);
        Cell instr = instrRow.createCell(0);
        instr.setCellValue("Reference: Copy values from 'Display Name' column when filling Voucher Entry");
        instr.setCellStyle(instructionStyle);
        sheet.addMergedRegion(new org.apache.poi.ss.util.CellRangeAddress(0, 0, 0, 4));

        Row headerRow = sheet.createRow(1);
        String[] headers = {"SubLedger ID", "SubLedger Name", "Ledger ID", "Ledger Name", "Display Name"};
        for (int i = 0; i < headers.length; i++) {
            Cell cell = headerRow.createCell(i);
            cell.setCellValue(headers[i]);
            cell.setCellStyle(headerStyle);
        }

        // Collect all subledger entries
        List<SubLedgerEntry> entries = new ArrayList<SubLedgerEntry>();

        for (SubLedgerMasterDto subLedger : subLedgers) {
            if (!subLedger.isActive()) {
                continue;
            }

            List<SubLedgerMasterLedgerMasterBranchMapMapDto> mappings
                    = subLedger.getSubLedgerMasterLedgerMasterBranchMapMapDtos();

            if (mappings != null && !mappings.isEmpty()) {
                for (SubLedgerMasterLedgerMasterBranchMapMapDto mapping : mappings) {
                    if (mapping.getLedgerMasterBranchMapDto() == null) {
                        continue;
                    }

                    SubLedgerEntry entry = new SubLedgerEntry();
                    entry.subLedgerId = subLedger.getId();
                    entry.subLedgerName = subLedger.getName();
                    entry.ledgerId = mapping.getLedgerMasterBranchMapDto().getLedgerMasterDto().getId();
                    entry.ledgerName = mapping.getLedgerMasterBranchMapDto().getLedgerMasterDto().getName();
                    entries.add(entry);
                }
            }
        }

        // Sort by Ledger ID
        entries.sort(Comparator.comparing(e -> e.ledgerId));

        // Check for duplicates
        Map<String, Integer> nameCount = new HashMap<String, Integer>();
        for (SubLedgerEntry entry : entries) {
            String key = entry.subLedgerName + "|" + entry.ledgerId;
            nameCount.put(key, nameCount.getOrDefault(key, 0) + 1);
        }

        // Populate data
        int rowNum = 2;
        for (SubLedgerEntry entry : entries) {
            Row row = sheet.createRow(rowNum++);

            row.createCell(0).setCellValue(entry.subLedgerId);
            row.createCell(1).setCellValue(entry.subLedgerName);
            row.createCell(2).setCellValue(entry.ledgerId);
            row.createCell(3).setCellValue(entry.ledgerName);

            // Display Name with ID if duplicate
            Cell displayCell = row.createCell(4);
            String key = entry.subLedgerName + "|" + entry.ledgerId;
            if (nameCount.get(key) > 1) {
                displayCell.setCellValue(entry.subLedgerName + " [" + entry.subLedgerId + "]");
            } else {
                displayCell.setCellValue(entry.subLedgerName);
            }
        }

        // Set column widths
        sheet.setColumnWidth(0, 3000);
        sheet.setColumnWidth(1, 8000);
        sheet.setColumnWidth(2, 3000);
        sheet.setColumnWidth(3, 8000);
        sheet.setColumnWidth(4, 8000);
    }

    // ========== STYLE METHODS ==========
    private static HSSFCellStyle createHeaderStyle(HSSFWorkbook workbook) {
        HSSFCellStyle style = workbook.createCellStyle();
        HSSFFont font = workbook.createFont();
        font.setFontHeightInPoints((short) 11);
        style.setFont(font);
        style.setFillForegroundColor(IndexedColors.GREY_25_PERCENT.getIndex());
        style.setFillPattern(CellStyle.SOLID_FOREGROUND);
        style.setBorderBottom(CellStyle.BORDER_THIN);
        style.setBorderTop(CellStyle.BORDER_THIN);
        style.setBorderLeft(CellStyle.BORDER_THIN);
        style.setBorderRight(CellStyle.BORDER_THIN);
        style.setAlignment(CellStyle.ALIGN_CENTER);
        return style;
    }

    private static HSSFCellStyle createFooterStyle(HSSFWorkbook workbook) {
        HSSFCellStyle style = workbook.createCellStyle();
        HSSFFont font = workbook.createFont();
        font.setFontHeightInPoints((short) 10);
        style.setFont(font);
        style.setBorderTop(CellStyle.BORDER_MEDIUM);
        style.setDataFormat(workbook.createDataFormat().getFormat("#,##0.00"));
        return style;
    }

    private static HSSFCellStyle createNumberStyle(HSSFWorkbook workbook) {
        HSSFCellStyle style = workbook.createCellStyle();
        style.setDataFormat(workbook.createDataFormat().getFormat("#,##0.00"));
        return style;
    }

    private static HSSFCellStyle createFormulaStyle(HSSFWorkbook workbook) {
        HSSFCellStyle style = workbook.createCellStyle();
        style.setFillForegroundColor(IndexedColors.LIGHT_YELLOW.getIndex());
        style.setFillPattern(CellStyle.SOLID_FOREGROUND);
        style.setLocked(true);
        return style;
    }

    private static HSSFCellStyle createInstructionStyle(HSSFWorkbook workbook) {
        HSSFCellStyle style = workbook.createCellStyle();
        HSSFFont font = workbook.createFont();
        font.setItalic(true);
        font.setColor(IndexedColors.DARK_BLUE.getIndex());
        style.setFont(font);
        style.setFillForegroundColor(IndexedColors.LIGHT_CORNFLOWER_BLUE.getIndex());
        style.setFillPattern(CellStyle.SOLID_FOREGROUND);
        style.setWrapText(true);
        return style;
    }

    private static void downloadWorkbook(HSSFWorkbook workbook, String fileName) throws IOException {
        HttpServletResponse response = getHttpServletResponse();

        // Ensure fileName ends with .xls
        if (fileName.endsWith(".xlsx")) {
            fileName = fileName.substring(0, fileName.length() - 1);
        } else if (!fileName.endsWith(".xls")) {
            fileName = fileName + ".xls";
        }

        setupDownloadResponse(response, fileName);
        workbook.write(response.getOutputStream());
        FacesContext.getCurrentInstance().responseComplete();
    }

    // Helper class
    private static class SubLedgerEntry {
        Strin subLedgerId;
        String subLedgerName;
        Long ledgerId;
        String ledgerName;
    }
}

