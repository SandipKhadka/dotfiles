package com.akshamalainfotech.erp.ejb.service.collegeAdmin.attendance.impl;

import com.akshamalainfotech.erp.constant.AttendanceDeviceTypeConstant;
import com.akshamalainfotech.erp.ejb.entity.collegeAdmin.AttendanceDevice;
import com.akshamalainfotech.erp.ejb.service.collegeAdmin.AttendanceDataIngestRouterService;
import com.akshamalainfotech.erp.ejb.service.collegeAdmin.StaffAttendanceDeviceIngestService;
import com.akshamalainfotech.erp.ejb.service.collegeAdmin.StudentAttendanceDeviceIngestService;

import javax.ejb.Stateless;
import javax.inject.Inject;
import java.util.logging.Level;
import java.util.logging.Logger;

@Stateless
public class AttendanceDataIngestRouterServiceImpl implements AttendanceDataIngestRouterService {

    private static final Logger LOGGER = Logger.getLogger(AttendanceDataIngestRouterServiceImpl.class.getName());

    @Inject
    private StaffAttendanceDeviceIngestService staffAttendanceDeviceIngestService;

    @Inject
    private StudentAttendanceDeviceIngestService studentAttendanceDeviceIngestService;

    @Override
    public void routeAttendanceData(String serialNumber, String payload, AttendanceDevice device) {
        String deviceType = device.getDeviceType();

        if (deviceType == null) {
            LOGGER.log(Level.WARNING, "Device type not set for device: {0}, defaulting to STAFF", serialNumber);
            staffAttendanceDeviceIngestService.ingestAttendanceData(serialNumber, payload, device);
            return;
        }

        switch (deviceType) {
            case AttendanceDeviceTypeConstant.STAFF.getName():
                LOGGER.log(Level.FINE, "Routing to staff ingest service for device: {0}", serialNumber);
                staffAttendanceDeviceIngestService.ingestAttendanceData(serialNumber, payload, device);
                break;
            case AttendanceDeviceTypeConstant.STAFF.getName():
                LOGGER.log(Level.FINE, "Routing to student ingest service for device: {0}", serialNumber);
                studentAttendanceDeviceIngestService.ingestAttendanceData(serialNumber, payload, device);
                break;
            default:
                LOGGER.log(Level.WARNING, "Unknown device type: {0} for device: {1}, defaulting to STAFF",
                        new Object[]{deviceType, serialNumber});
                staffAttendanceDeviceIngestService.ingestAttendanceData(serialNumber, payload, device);
                break;
        }
    }
}
