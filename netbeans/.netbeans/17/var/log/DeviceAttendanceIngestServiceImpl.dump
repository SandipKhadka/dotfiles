package com.akshamalainfotech.erp.ejb.service.collegeAdmin.attendance.impl;

import com.akshamalainfotech.erp.constant.SyncBatchStatus;
import com.akshamalainfotech.erp.ejb.common.dao.AttendanceDeviceDao;
import com.akshamalainfotech.erp.ejb.common.dao.DeviceAttendanceRawDao;
import com.akshamalainfotech.erp.ejb.common.dao.DeviceSyncBatchDao;
import com.akshamalainfotech.erp.ejb.common.dao.StatusDao;
import com.akshamalainfotech.erp.ejb.entity.collegeAdmin.AttendanceDevice;
import com.akshamalainfotech.erp.ejb.entity.collegeAdmin.DeviceAttendanceRaw;
import com.akshamalainfotech.erp.ejb.entity.collegeAdmin.DeviceSyncBatch;
import com.akshamalainfotech.erp.ejb.service.collegeAdmin.DeviceAttendanceIngestService;
import lombok.extern.slf4j.Slf4j;

import javax.ejb.TransactionAttribute;
import javax.ejb.TransactionAttributeType;
import javax.inject.Inject;
import java.text.ParseException;
import java.text.SimpleDateFormat;
import java.util.ArrayList;
import java.util.Date;
import java.util.List;
import javax.ejb.Local;

@Slf4j
@Local
public class DeviceAttendanceIngestServiceImpl implements DeviceAttendanceIngestService {


    @Inject
    private AttendanceDeviceDao attendanceDeviceDao;

    @Inject
    private DeviceAttendanceRawDao deviceAttendanceRawDao;

    @Inject
    private DeviceSyncBatchDao deviceSyncBatchDao;
    
    @Inject
    private StatusDao statusD

    @TransactionAttribute(TransactionAttributeType.REQUIRES_NEW)
    public void ingestAttendanceData(String serialNumber, String payload, AttendanceDevice device) {

        if (payload == null || payload.trim().isEmpty()) {
            log.debug("Empty payload received from device: {}, skipping ingestion", serialNumber);
            return;
        }


        long startTime = System.currentTimeMillis();

        DeviceSyncBatch syncBatch = DeviceSyncBatch.builder()
                .device(device)
                .syncDate(new Date())
                .build();

        String[] lines = payload.split("\\r?\\n");
        int receivedCount = 0;
        int savedCount = 0;
        List<String> errors = new ArrayList<>();

        for (String line : lines) {
            line = line.trim();

            if (line.isEmpty()) {
                continue;
            }

            receivedCount++;

            try {
                if (processAttendanceLine(line, device)) {
                    savedCount++;
                } else {
                    log.warn("Failed to process line from device {}: {}", serialNumber, line);
                }

            } catch (Exception e) {
                String errorMsg = String.format("Error processing line '%s': %s",
                        line, e.getMessage());
                errors.add(errorMsg);
                log.error(errorMsg, e);
            }
        }

        device.setAttendanceLogStamp(device.getAttendanceLogStamp() + receivedCount);
        attendanceDeviceDao.modify(device);

        long duration = System.currentTimeMillis() - startTime;

        syncBatch.setRecordsReceived(receivedCount);
        syncBatch.setRecordsSaved(savedCount);
        syncBatch.setSyncDurationMs(duration);

        if (errors.isEmpty()) {
            syncBatch.setSyncBatchStatus(SyncBatchStatus.SUCCESS);
            log.info("Successfully ingested {} attendance records from device {} in {}ms",
                    savedCount, serialNumber, duration);
        } else {
            syncBatch.setSyncBatchStatus(SyncBatchStatus.PARTIAL);
            syncBatch.setErrorSummary(String.join("; ", errors));
            log.warn("Partially ingested attendance from device {}: {} saved, {} errors",
                    serialNumber, savedCount, errors.size());
        }

        deviceSyncBatchDao.save(syncBatch);
    }

    private boolean processAttendanceLine(String line, AttendanceDevice device) {
        log.debug("Processing attendance line: {}", line);

        String[] parts = line.split("\\t");

        if (parts.length < 4) {
            log.warn("Invalid line format (expected at least 4 parts, got {}): {}",
                    parts.length, line);
            return false;
        }

        String employeeCode = parts[0].trim();
        String dateTimeStr = parts[1].trim();
        String status = parts.length > 2 ? parts[2].trim() : "0";
        String verifyType = parts.length > 3 ? parts[3].trim() : "0";
        String workCode = parts.length > 4 ? parts[4].trim() : "0";

        Date punchTime = parseDateTime(dateTimeStr);

        if (punchTime == null) {
            log.warn("Cannot parse datetime '{}' from line: {}", dateTimeStr, line);
            return false;
        }

        DeviceAttendanceRaw raw = DeviceAttendanceRaw.builder()
                .attendanceDevice(device)
                .employeeCode(employeeCode)
                .punchTime(punchTime)
                .verifyType(mapVerifyType(verifyType))
                .punchState(mapPunchState(status))
                .workCode(workCode)
                .processed(false)
                .retryCount(0)
                .build();
        raw.setCreatedDate(new Date());
        raw.setStatus(statusD);

        deviceAttendanceRawDao.save(raw);

        log.debug("Saved raw attendance: employee={}, punchTime={}, state={}",
                employeeCode, punchTime, raw.getPunchState());

        return true;
    }

    private Date parseDateTime(String dateTimeStr) {
        String[] formats = {
                "yyyy-MM-dd HH:mm:ss",
                "yyyy/MM/dd HH:mm:ss",
                "dd/MM/yyyy HH:mm:ss",
                "MM/dd/yyyy HH:mm:ss",
                "yyyy-MM-dd'T'HH:mm:ss"
        };

        for (String format : formats) {
            try {
                SimpleDateFormat sdf = new SimpleDateFormat(format);
                sdf.setLenient(false);
                Date parsed = sdf.parse(dateTimeStr);
                log.debug("Successfully parsed datetime '{}' using format '{}'",
                        dateTimeStr, format);
                return parsed;
            } catch (ParseException e) {
                log.trace("Failed to parse '{}' with format '{}'", dateTimeStr, format);
            }
        }

        log.warn("Could not parse datetime string: {}", dateTimeStr);
        return null;
    }

    private String mapVerifyType(String code) {
        switch (code) {
            case "0":
                return "Password";
            case "1":
                return "Fingerprint";
            case "3":
                return "Card";
            case "4":
            case "15":
                return "Face";
            default:
                log.debug("Unknown verify type code: {}, defaulting to 'Unknown'", code);
                return "Unknown";
        }
    }

    private String mapPunchState(String code) {
        switch (code) {
            case "0":
                return "Check In";
            case "1":
                return "Check Out";
            case "2":
                return "Break Out";
            case "3":
                return "Break In";
            case "4":
                return "OT In";
            case "5":
                return "OT Out";
            default:
                log.debug("Unknown punch state code: {}, defaulting to 'Check In'", code);
                return "Check In";
        }
    }
}

